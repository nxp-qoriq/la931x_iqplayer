+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""la9310shiva transport adapter ("shiva") for the la9310_debug self-hosted path.
+
+Works with any host running the NXP la9310shiva kernel driver: the RFNM
+board (i.MX8M Plus) and the LimeSDR-Micro on an i.MX95 with the NXP BSP.
+Replaces M4Proxy (LimeSuiteNG la9310_limesdr driver, window-based mmap)
+with ShivaPort (physical-address mmap).
+
+The adapter uses:
+
+  /dev/shiva0  -- ioctl IOCTL_LA93XX_MODINFO_GET (discover host phys addrs),
+                  fcntl.flock for proxy mutual exclusion, and mmap of
+                  CCSR/TCML/TCMU when the driver allows it (la93xx_host_sw
+                  "modinfo mmap scratch, iqflood and PCIe BARs" patch).
+
+  /dev/mem     -- fallback mmap for CCSR, TCML, TCMU (PCIe BAR windows)
+                  when the shiva mmap handler rejects them (EINVAL).
+                  Opened O_RDWR|O_SYNC.
+
+The HIF location and layout differ between firmware trees:
+
+  RFNM la93xx_freertos : HIF at TCML+0x1C000, sw_cmd_desc at HIF+0x218
+  NXP  la93xx_freertos : HIF at TCML+0x1B000, sw_cmd_desc at HIF+0x240
+                         (HIF also carries adc/dac masks, iq_mem fields)
+
+The NXP firmware publishes the HIF offset in DCFG SCRATCHRW[3]; when it
+holds a known value the layout is picked from it, otherwise the RFNM
+layout is used. SHIVA_HIF_OFFSET / SHIVA_SW_CMD_OFFSET override both.
+
+ShivaPort provides exactly the same public interface as M4Proxy so it can be
+passed directly to SelfHostedClient(port=ShivaPort()) and to
+vspa_boot_handshake(port, ...).
+
+VSPA debug access uses the M4 firmware sw_cmd engine:
+  - LA9310_SW_CMD_VSPA_DBG (cmd=1) via la9310_sw_cmd_desc in HIF (TCML)
+  - MSG unit 2 MSIIR doorbell at CCSR+0x1FC0008 kicks the M4 sw_cmd task
+  - Firmware fills data[] and sets status=DONE (5)
+
+Typical use:
+    from shiva_port import ShivaPort
+    from selfhosted import SelfHostedClient
+    client = SelfHostedClient(port=ShivaPort())
+
+Or from the command line (wraps selfhosted.py CLI):
+    python3 shiva_port.py heartbeat
+    python3 shiva_port.py info
+    python3 shiva_port.py load /lib/firmware/apm.eld
+"""
+
+import ctypes
+import fcntl
+import mmap
+import os
+import struct
+import sys
+import time
+
+# ---------------------------------------------------------------------------
+# modinfo ioctl definitions (uapi/la9310_modinfo.h)
+# ---------------------------------------------------------------------------
+
+SHIVA_DEVICE = os.environ.get("SHIVA_DEVICE", os.environ.get("RFNM_SHIVA_DEVICE", "/dev/shiva0"))
+
+LA9310_MODINFO_MAGIC = ord('R')
+
+_IOC_WRITE = 1
+
+
+def _IOW(type_, nr, size):
+    return ((_IOC_WRITE << 30) | (size << 16) | (type_ << 8) | nr) & 0xFFFFFFFF
+
+
+IOCTL_LA93XX_MODINFO_GET = _IOW(LA9310_MODINFO_MAGIC, 1, 8)  # sizeof(modinfo_t *)
+
+
+class _AddrMap(ctypes.Structure):
+    _fields_ = [
+        ("host_phy_addr", ctypes.c_uint64),
+        ("modem_phy_addr", ctypes.c_uint32),
+        ("size", ctypes.c_uint32),
+    ]
+
+
+class _Modinfo(ctypes.Structure):
+    _fields_ = [
+        ("active", ctypes.c_uint32),
+        ("id", ctypes.c_uint32),
+        ("rev", ctypes.c_uint32),
+        ("board_name", ctypes.c_char * 64),
+        ("name", ctypes.c_char * 64),
+        ("pci_addr", ctypes.c_char * 64),
+        ("fw_name", ctypes.c_char * 64),
+        ("ccsr", _AddrMap),
+        ("tcml", _AddrMap),
+        ("tcmu", _AddrMap),
+        ("dbg", _AddrMap),
+        ("iqr", _AddrMap),
+        ("ov", _AddrMap),
+        ("nlmops", _AddrMap),
+        ("hif", _AddrMap),
+        ("vspa", _AddrMap),
+        ("fw", _AddrMap),
+        ("stdfw", _AddrMap),
+        ("pciwin", _AddrMap),
+        ("scratchbuf", _AddrMap),
+        ("iqflood", _AddrMap),
+        ("rfcal", _AddrMap),
+        ("dac_mask", ctypes.c_int),
+        ("adc_mask", ctypes.c_int),
+        ("adc_rate_mask", ctypes.c_int),
+        ("dac_rate_mask", ctypes.c_int),
+    ]
+
+
+def _modinfo_get(fd):
+    """Issue IOCTL_LA93XX_MODINFO_GET and return the filled _Modinfo struct."""
+    mi = _Modinfo()
+    buf = bytearray(ctypes.sizeof(mi))
+    try:
+        fcntl.ioctl(fd, IOCTL_LA93XX_MODINFO_GET, buf)
+    except OSError as e:
+        raise ShivaPortError(f"IOCTL_LA93XX_MODINFO_GET failed: {e}") from None
+    ctypes.memmove(ctypes.addressof(mi), bytes(buf), ctypes.sizeof(mi))
+    return mi
+
+
+# ---------------------------------------------------------------------------
+# HIF ctypes structs (mirror la9310_host_if.h) for sw_cmd_desc offset
+#
+# la9310_hif is __attribute__((packed)); the inner structs la9310_stats and
+# la9310_eDMA are NOT packed and retain their own internal alignment/padding.
+# ctypes _pack_=1 on _La9310Hif removes inter-field gaps in the outer struct
+# while the un-packed inner structs keep their natural layout, exactly
+# matching the C compiler output.
+# ---------------------------------------------------------------------------
+
+# V2H constants from la9310_v2h_if.h
+_V2H_MAX_BD = 16
+_MAX_SENT_RESUME = 5
+_LA9310_EDMA_CHANNELS = 14
+_LA9310_SW_CMD_DATA_SIZE = 32
+
+
+class _IrqEvtRegs(ctypes.Structure):
+    # 7 uint32_t fields, no padding needed
+    _fields_ = [
+        ("irq_evt_cfg",    ctypes.c_uint32),
+        ("irq_evt_en",     ctypes.c_uint32),
+        ("irq_evt_status", ctypes.c_uint32),
+        ("irq_evt_clr",    ctypes.c_uint32),
+        ("vspa_evt_mask",  ctypes.c_uint32),
+        ("ipc_evt_mask",   ctypes.c_uint32),
+        ("test_evt_mask",  ctypes.c_uint32),
+    ]
+
+
+class _DebugLogRegs(ctypes.Structure):
+    # 3 uint32_t fields
+    _fields_ = [
+        ("buf",       ctypes.c_uint32),
+        ("len",       ctypes.c_uint32),
+        ("log_level", ctypes.c_uint32),
+    ]
+
+
+class _La9310eDMA(ctypes.Structure):
+    # NOT packed; uint8_t status + 3 bytes pad + 4 uint32_t = 20 bytes
+    _fields_ = [
+        ("status",             ctypes.c_uint8),
+        ("xfer_req",           ctypes.c_uint32),
+        ("success_interrupt",  ctypes.c_uint32),
+        ("error_interrupt",    ctypes.c_uint32),
+        ("no_callback_reg",    ctypes.c_uint32),
+    ]
+
+
+class _La9310Stats(ctypes.Structure):
+    # NOT packed -- natural alignment
+    _fields_ = [
+        ("disabled_evt_try_cnt",          ctypes.c_uint32),
+        ("irq_evt_raised",                ctypes.c_uint32),
+        ("irq_evt_cleared",               ctypes.c_uint32),
+        ("irq_mux_tx_msi_cnt",            ctypes.c_uint32),
+        ("irq_mux_rx_msi_cnt",            ctypes.c_uint32),
+        ("v2h_sent_pkt",                  ctypes.c_uint32),
+        ("v2h_dropped_pkt",               ctypes.c_uint32),
+        ("v2h_resumed",                   ctypes.c_uint32),
+        ("v2h_last_sent_pkt",             ctypes.c_uint32),
+        ("v2h_last_dropped_pkt",          ctypes.c_uint32),
+        ("v2h_last_sent_pkt_resumed",     ctypes.c_uint32 * _MAX_SENT_RESUME),
+        ("v2h_last_dropped_pkt_resumed",  ctypes.c_uint32 * _MAX_SENT_RESUME),
+        ("v2h_final_ring_owner",          ctypes.c_uint32 * _V2H_MAX_BD),
+        ("v2h_backout_count",             ctypes.c_uint32),
+        ("avi_cm4_mbox0_tx_cnt",          ctypes.c_uint32),
+        ("avi_cm4_mbox1_tx_cnt",          ctypes.c_uint32),
+        ("avi_cm4_mbox0_rx_cnt",          ctypes.c_uint32),
+        ("avi_cm4_mbox1_rx_cnt",          ctypes.c_uint32),
+        ("avi_err_queue_full",            ctypes.c_uint32),
+        ("avi_intr_raised",               ctypes.c_uint32),
+        ("avi_mbox_intr_raised",          ctypes.c_uint32),
+        ("eDMA_ch_allocated",             ctypes.c_uint32),
+        ("la9310_eDMA_ch",                _La9310eDMA * _LA9310_EDMA_CHANNELS),
+        ("WDOG_interrupt",                ctypes.c_uint32),
+        ("v2h_intr_enabled",              ctypes.c_uint32),
+    ]
+
+
+class _HifIpcRegs(ctypes.Structure):
+    _fields_ = [
+        ("ipc_mdata_offset", ctypes.c_uint32),
+        ("ipc_mdata_size",   ctypes.c_uint32),
+    ]
+
+
+class _La9310SwCmdDesc(ctypes.Structure):
+    _fields_ = [
+        ("cmd",    ctypes.c_uint32),
+        ("status", ctypes.c_uint32),   # enum la9310_sw_cmd_status -> uint32
+        ("data",   ctypes.c_uint32 * _LA9310_SW_CMD_DATA_SIZE),
+    ]
+
+
+class _La9310Hif(ctypes.Structure):
+    # Outer struct is __attribute__((packed)); use _pack_=1 in ctypes.
+    # Inner structs retain their own natural alignment/padding.
+    _pack_ = 1
+    _fields_ = [
+        ("ver",          ctypes.c_uint32),
+        ("hif_ver",      ctypes.c_uint32),
+        ("status",       ctypes.c_uint32),
+        ("host_ready",   ctypes.c_uint32),
+        ("mod_ready",    ctypes.c_uint32),
+        ("irq_evt_regs", _IrqEvtRegs),
+        ("dbg_log_regs", _DebugLogRegs),
+        ("stats",        _La9310Stats),
+        ("ipc_regs",     _HifIpcRegs),
+        ("sw_cmd_desc",  _La9310SwCmdDesc),
+    ]
+
+
+# Byte offset of sw_cmd_desc within la9310_hif (computed once from ctypes)
+_SW_CMD_DESC_HIF_OFF = _La9310Hif.sw_cmd_desc.offset
+
+# ---------------------------------------------------------------------------
+# sw_cmd / VSPA debug constants (la9310_host_if.h, vspa_debug.h)
+# ---------------------------------------------------------------------------
+
+LA9310_SW_CMD_VSPA_DBG       = 1
+LA9310_SW_CMD_STATUS_POSTED  = 1
+LA9310_SW_CMD_STATUS_DONE    = 5
+
+# Offset of sw_cmd_desc from TCML base (HIF starts at LA9310_EP_HIF_OFFSET).
+# Default: RFNM layout (computed from the ctypes mirror above).
+LA9310_EP_HIF_OFFSET  = 0x1C000
+SW_CMD_DESC_TCML_OFF  = LA9310_EP_HIF_OFFSET + _SW_CMD_DESC_HIF_OFF
+
+# HIF offset -> sw_cmd_desc offset inside the HIF, per firmware tree.
+# NXP la93xx_freertos adds 8 words to la9310_hif (adc/dac masks, iq_mem_*,
+# modem_rf_data_size) and dbg1/dbg2 to la9310_stats: 0x218 + 0x28 = 0x240.
+HIF_LAYOUTS = {
+    0x1C000: _SW_CMD_DESC_HIF_OFF,   # RFNM la93xx_freertos
+    0x1B000: 0x240,                  # NXP la93xx_freertos (LimeSDR-Micro)
+}
+
+# DCFG SCRATCHRW[3] (LA9310_BOOT_HSHAKE_HIF_REG): HIF offset published by
+# the NXP firmware. DCFG is at CCSR + 0x1E00000, scratchrw[] at +0x200.
+DCFG_SCRATCHRW3_CCSR_OFF = 0x1E00000 + 0x200 + 3 * 4
+
+
+def sw_cmd_desc_offset(hif_reg):
+    """TCML byte offset of sw_cmd_desc, from SCRATCHRW[3] and env overrides."""
+    env_hif = os.environ.get("SHIVA_HIF_OFFSET")
+    env_sw = os.environ.get("SHIVA_SW_CMD_OFFSET")
+    hif = int(env_hif, 0) if env_hif else (
+        hif_reg if hif_reg in HIF_LAYOUTS else LA9310_EP_HIF_OFFSET)
+    sw = int(env_sw, 0) if env_sw else HIF_LAYOUTS.get(hif, _SW_CMD_DESC_HIF_OFF)
+    return hif + sw
+
+# VSPA debug op/flag codes (vspa_debug.h)
+OP_READ    = 1
+OP_WRITE   = 2
+FLAG_FIXED = 1 << 8
+
+VSPA_DBG_MAX_WORDS = int(os.environ.get("VSPA_DBG_MAX_WORDS", 0)) or 28
+
+# MSG unit 2 MSIIR -- CCSR offset 0x1FC0008
+# MSG_UNIT_BASE_ADDR = CCSR_BASE + 0x1FC0000; MSG_UNIT_2 index = 1;
+# each unit is 8 bytes (msiir+msir); so unit2 MSIIR = 0x1FC0000 + 1*8 = 0x1FC0008
+MSIIR2_CCSR_OFF = 0x1FC0008
+
+# Error codes from vspa_debug.h
+_VSPA_DBG_ERRORS = {1: "bad op", 2: "offset outside debug block", 3: "bad word count"}
+
+# TCMU free region (iqplayer overlay load target)
+TCMU_FREE = (0x20001000, 0x20008000)
+
+
+# ---------------------------------------------------------------------------
+# Public exception
+# ---------------------------------------------------------------------------
+
+class ShivaPortError(RuntimeError):
+    pass
+
+
+def check_tcmu_free(address, count):
+    lo, hi = TCMU_FREE
+    if address & 3 or not lo <= address <= address + 4 * count <= hi:
+        raise ShivaPortError(
+            f"system address 0x{address:08X}+{4 * count} outside the free TCMU "
+            f"range 0x{lo:08X}-0x{hi - 1:08X}")
+
+
+# ---------------------------------------------------------------------------
+# ShivaPort
+# ---------------------------------------------------------------------------
+
+class ShivaPort:
+    """VSPA_DBG access through the M4 sw_cmd engine, via /dev/shiva0.
+
+    Drop-in replacement for selfhosted.M4Proxy; exposes the same interface:
+      dbg_read / dbg_write / mem_read / mem_write / heartbeat / close
+    plus the ccsr32 memoryview attribute used by vspa_boot_handshake().
+
+    VSPA debug commands are dispatched via LA9310_SW_CMD_VSPA_DBG:
+      1. Write cmd + payload into sw_cmd_desc in TCML (at SW_CMD_DESC_TCML_OFF)
+      2. Set status = POSTED and write 0 to MSG2 MSIIR (CCSR+0x1FC0008)
+      3. Poll status until DONE (5) or timeout
+    """
+
+    def __init__(self, device=SHIVA_DEVICE, timeout=1.0):
+        self.timeout = timeout
+        self._tcmu_mmap = None
+        self._tcmu_phys = None
+        self._tcmu_size = None
+        try:
+            self.fd = os.open(device, os.O_RDWR)
+        except OSError as e:
+            raise ShivaPortError(f"cannot open {device}: {e}") from None
+        try:
+            mi = _modinfo_get(self.fd)
+        except ShivaPortError:
+            os.close(self.fd)
+            raise
+
+        ccsr_phys = mi.ccsr.host_phy_addr
+        ccsr_size = mi.ccsr.size or 0x4000000
+        tcml_phys = mi.tcml.host_phy_addr
+        tcml_size = mi.tcml.size or 0x20000
+        self._tcmu_phys = mi.tcmu.host_phy_addr
+        self._tcmu_size = mi.tcmu.size or 0x800000
+
+        if not ccsr_phys or not tcml_phys:
+            os.close(self.fd)
+            raise ShivaPortError(
+                f"modinfo returned zero phys addrs "
+                f"(ccsr=0x{ccsr_phys:X} tcml=0x{tcml_phys:X}): "
+                "is la9310shiva.ko loaded and the M4 firmware running?")
+
+        # CCSR and TCML are PCIe BAR regions. Map them through /dev/shiva0
+        # when the driver allows it (la93xx_host_sw modinfo mmap patch, works
+        # with CONFIG_STRICT_DEVMEM=y); otherwise fall back to /dev/mem.
+        self._devmem_fd = None
+        self._map_fd = self.fd
+        try:
+            self._bar0 = mmap.mmap(self.fd, ccsr_size, offset=ccsr_phys)
+            self._bar1 = mmap.mmap(self.fd, tcml_size, offset=tcml_phys)
+        except OSError:
+            if getattr(self, "_bar0", None) is not None:
+                self._bar0.close()
+            try:
+                self._devmem_fd = os.open("/dev/mem", os.O_RDWR | os.O_SYNC)
+            except OSError as e:
+                os.close(self.fd)
+                raise ShivaPortError(f"cannot open /dev/mem: {e}") from None
+            self._map_fd = self._devmem_fd
+            try:
+                self._bar0 = mmap.mmap(self._devmem_fd, ccsr_size, offset=ccsr_phys)
+                self._bar1 = mmap.mmap(self._devmem_fd, tcml_size, offset=tcml_phys)
+            except OSError as e:
+                os.close(self._devmem_fd)
+                os.close(self.fd)
+                raise ShivaPortError(
+                    f"mmap of CCSR/TCML via /dev/shiva0 and /dev/mem failed: {e}") from None
+
+        # 32-bit typed views (BAR0/BAR1 accept 32-bit accesses only)
+        self.ccsr32 = memoryview(self._bar0).cast("I")
+        self.tcml32 = memoryview(self._bar1).cast("I")
+
+        # Pre-computed word index of sw_cmd_desc fields in tcml32
+        self.sw_cmd_off = sw_cmd_desc_offset(
+            self.ccsr32[DCFG_SCRATCHRW3_CCSR_OFF // 4])
+        self._sw_desc_w = self.sw_cmd_off // 4  # cmd word index
+        # cmd   = tcml32[_sw_desc_w + 0]
+        # status= tcml32[_sw_desc_w + 1]
+        # data  = tcml32[_sw_desc_w + 2 + i]
+
+        # Pre-computed word slice of MSG2 MSIIR in ccsr32 (write 0 to kick M4)
+        self._msiir2_w = MSIIR2_CCSR_OFF // 4
+
+    def close(self):
+        self.ccsr32.release()
+        self.tcml32.release()
+        self._bar0.close()
+        self._bar1.close()
+        if self._tcmu_mmap is not None:
+            self._tcmu_mmap.close()
+        if self._devmem_fd is not None:
+            os.close(self._devmem_fd)
+        os.close(self.fd)
+
+    # -- TCMU (system address space, overlay load / mem_read / mem_write) ---
+
+    def _tcmu(self, address, count):
+        check_tcmu_free(address, count)
+        if self._tcmu_mmap is None:
+            try:
+                self._tcmu_mmap = mmap.mmap(
+                    self._map_fd, self._tcmu_size, offset=self._tcmu_phys)
+            except OSError as e:
+                raise ShivaPortError(f"mmap of TCMU failed: {e}") from None
+        # The TCMU free region starts at modem address 0x20000000;
+        # the mmap covers the whole TCMU from that base.
+        return address - 0x20000000
+
+    def mem_read(self, address, count=1):
+        """Read words at a system address (free TCMU only)."""
+        offset = self._tcmu(address, count)
+        return list(struct.unpack_from(f"<{count}I", self._tcmu_mmap, offset))
+
+    def mem_write(self, address, values):
+        """Write words at a system address (free TCMU only)."""
+        offset = self._tcmu(address, len(values))
+        struct.pack_into(f"<{len(values)}I", self._tcmu_mmap, offset,
+                         *(v & 0xFFFFFFFF for v in values))
+
+    # -- sw_cmd VSPA debug protocol -----------------------------------------
+
+    def heartbeat(self):
+        """Verify the M4 firmware answers sw_cmd VSPA debug requests."""
+        from selfhosted import GDBEN
+        self.dbg_read(GDBEN)
+
+    def dbg_access(self, op, offset, count, values=None, fixed=False):
+        """Single VSPA debug transaction via the M4 sw_cmd engine.
+
+        Sends LA9310_SW_CMD_VSPA_DBG, polls until DONE, returns data words
+        for reads.  Raises ShivaPortError on timeout or firmware error.
+        """
+        fcntl.flock(self.fd, fcntl.LOCK_EX)
+        try:
+            tcml = self.tcml32
+            base = self._sw_desc_w  # word index of sw_cmd_desc.cmd
+
+            # Build op word: bits[7:0]=op, bit[8]=FIXED, bits[23:16]=count
+            op_word = (op & 0xFF) | (FLAG_FIXED if fixed else 0) | ((count & 0xFF) << 16)
+
+            # Write payload into data[]: data[0]=op_word, data[1]=offset,
+            # data[2..N]=write values.  Do this BEFORE posting the command.
+            tcml[base + 2] = op_word & 0xFFFFFFFF
+            tcml[base + 3] = offset & 0xFFFFFFFF
+            for i, v in enumerate(values or ()):
+                tcml[base + 4 + i] = v & 0xFFFFFFFF
+
+            # Write cmd id, then set status=POSTED in a single word write
+            # (cmd and status are adjacent uint32_t in the packed struct).
+            tcml[base] = LA9310_SW_CMD_VSPA_DBG
+            # Read-back cmd to ensure the store reached TCML before the
+            # status/doorbell write (memory ordering on ARM PCIe MMIO).
+            _ = tcml[base]
+            tcml[base + 1] = LA9310_SW_CMD_STATUS_POSTED
+
+            # Kick the M4 sw_cmd task via MSG unit 2 MSIIR doorbell.
+            self.ccsr32[self._msiir2_w] = 0
+
+            # Poll sw_cmd_desc.status until DONE or timeout.
+            deadline = time.monotonic() + self.timeout
+            while True:
+                st = tcml[base + 1]
+                if st == LA9310_SW_CMD_STATUS_DONE:
+                    break
+                if time.monotonic() > deadline:
+                    raise ShivaPortError(
+                        "M4 sw_cmd timeout (VSPA_DBG): "
+                        f"last status={st} op={op} offset=0x{offset:X} count={count}")
+
+            # data[0] holds the error code on completion (0 = ok).
+            err = tcml[base + 2]
+            if err:
+                raise ShivaPortError(
+                    f"M4 sw_cmd VSPA_DBG error {err} "
+                    f"({_VSPA_DBG_ERRORS.get(err, 'unknown')}) "
+                    f"op={op} offset=0x{offset:X} count={count}")
+
+            if op == OP_READ:
+                return [tcml[base + 4 + i] for i in range(count)]
+            return []
+        finally:
+            fcntl.flock(self.fd, fcntl.LOCK_UN)
+
+    def dbg_read(self, offset, count=1, fixed=False):
+        """Read count words from the VSPA debug register block."""
+        out = []
+        while count:
+            n = min(count, VSPA_DBG_MAX_WORDS)
+            out += self.dbg_access(OP_READ, offset, n, fixed=fixed)
+            if not fixed:
+                offset += 4 * n
+            count -= n
+        return out
+
+    def dbg_write(self, offset, values, fixed=False):
+        """Write values into the VSPA debug register block."""
+        index = 0
+        while index < len(values):
+            n = min(len(values) - index, VSPA_DBG_MAX_WORDS)
+            self.dbg_access(OP_WRITE, offset, n, values[index:index + n], fixed=fixed)
+            if not fixed:
+                offset += 4 * n
+            index += n
+
+
+# ---------------------------------------------------------------------------
+# Standalone CLI: forward to selfhosted.py using ShivaPort
+# ---------------------------------------------------------------------------
+
+def _cli(argv):
+    # Insert this transport into selfhosted's _cli by temporarily patching
+    # M4Proxy so every place that instantiates it gets an ShivaPort instead.
+    import selfhosted
+    _orig = selfhosted.M4Proxy
+    selfhosted.M4Proxy = ShivaPort
+    try:
+        return selfhosted._cli(argv)
+    finally:
+        selfhosted.M4Proxy = _orig
+
+
+if __name__ == "__main__":
+    sys.exit(_cli(sys.argv[1:]) or 0)
