diff --git a/Demo/CORTEX_M4_NXP_LA9310_GCC/sw_cmd_engine/vspa_debug.c b/Demo/CORTEX_M4_NXP_LA9310_GCC/sw_cmd_engine/vspa_debug.c
new file mode 100644
index 0000000..1605c18
--- /dev/null
+++ b/Demo/CORTEX_M4_NXP_LA9310_GCC/sw_cmd_engine/vspa_debug.c
@@ -0,0 +1,62 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+/*
+ * Copyright 2026 NXP
+ */
+
+#include "vspa_debug.h"
+#include "io.h"
+
+/* VSPA debug block on the M4 external PPB; see vspa_debug.h. */
+#define VSPA_DBG_BASE    0xE0046000u
+#define VSPA_DBG_SPAN    0x1000u
+
+uint32_t VspaDebugCommand( uint32_t * data )
+{
+    const uint32_t op = data[ 0 ] & 0xFFu;
+    const uint32_t fixed = data[ 0 ] & VSPA_DBG_FLAG_FIXED;
+    const uint32_t count = ( data[ 0 ] >> 16 ) & 0xFFu;
+    const uint32_t offset = data[ 1 ];
+    uint32_t span;
+    uint32_t addr;
+    uint32_t i;
+
+    if( ( op != VSPA_DBG_OP_READ ) && ( op != VSPA_DBG_OP_WRITE ) )
+    {
+        return VSPA_DBG_ERR_OP;
+    }
+
+    if( ( count == 0u ) || ( count > VSPA_DBG_MAX_WORDS ) )
+    {
+        return VSPA_DBG_ERR_COUNT;
+    }
+
+    span = fixed ? 4u : count * 4u;
+
+    if( ( offset & 3u ) || ( offset > VSPA_DBG_SPAN ) ||
+        ( ( offset + span ) > VSPA_DBG_SPAN ) )
+    {
+        return VSPA_DBG_ERR_OFFSET;
+    }
+
+    addr = VSPA_DBG_BASE + offset;
+
+    for( i = 0; i < count; i++ )
+    {
+        if( op == VSPA_DBG_OP_READ )
+        {
+            data[ 2 + i ] = IN_32( ( uint32_t * ) ( uintptr_t ) addr );
+        }
+        else
+        {
+            OUT_32( ( uint32_t * ) ( uintptr_t ) addr, data[ 2 + i ] );
+        }
+
+        if( !fixed )
+        {
+            addr += 4u;
+        }
+    }
+
+    return 0;
+}
diff --git a/Demo/CORTEX_M4_NXP_LA9310_GCC/sw_cmd_engine/vspa_debug.h b/Demo/CORTEX_M4_NXP_LA9310_GCC/sw_cmd_engine/vspa_debug.h
new file mode 100644
index 0000000..1ce6c39
--- /dev/null
+++ b/Demo/CORTEX_M4_NXP_LA9310_GCC/sw_cmd_engine/vspa_debug.h
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+/*
+ * Copyright 2026 NXP
+ */
+
+#ifndef _VSPA_DEBUG_H_
+#define _VSPA_DEBUG_H_
+
+#include <stdint.h>
+
+/* Host-driven proxy for the VSPA debug register block (VSPA_DBG).
+ *
+ * The block lives at 0xE0046000 on the Cortex-M4 external PPB (DCSR root
+ * 0xE0000000 + 0x46000) and is not reachable over any PCIe BAR, so the host
+ * asks the M4 to access it through the LA9310_SW_CMD_VSPA_DBG sw command
+ * (la9310_debug, "shiva" transport).
+ *
+ * Payload layout in la9310_sw_cmd_desc.data[32]:
+ *   in : data[0] = op word: bits[7:0] op (1=read, 2=write),
+ *                  bit[8] fixed-address flag (burst on one register,
+ *                  e.g. the auto-incrementing RAVID portal data register),
+ *                  bits[23:16] word count (1..28)
+ *        data[1] = byte offset inside the 4 KB block (word aligned)
+ *        data[2..2+count-1] = values to write (write op only)
+ *   out: data[0] = 0 on success, VSPA_DBG_ERR_* otherwise
+ *        data[2..2+count-1] = values read (read op only)
+ */
+
+#define VSPA_DBG_OP_READ      1u
+#define VSPA_DBG_OP_WRITE     2u
+#define VSPA_DBG_FLAG_FIXED   ( 1u << 8 )
+#define VSPA_DBG_MAX_WORDS    28u
+
+#define VSPA_DBG_ERR_OP       1u
+#define VSPA_DBG_ERR_OFFSET   2u
+#define VSPA_DBG_ERR_COUNT    3u
+
+uint32_t VspaDebugCommand( uint32_t * data );
+
+#endif /* _VSPA_DEBUG_H_ */
diff --git a/common_headers/la9310_host_if.h b/common_headers/la9310_host_if.h
